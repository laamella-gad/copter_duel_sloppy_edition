; copterduel.vsf: VICE snapshot of a C64SC
; $01 = $37: BASIC in, KERNAL in, I/O in
; CPU: PC $3181 A $37 X $00 Y $00 SP $f4 P $25
; stack $01f5-$0200: 59 01 46 e1 e9 a7 a7 79 a6 9c e3
; top of stack as a jsr return address: $015a
; top of stack as an interrupt's return address: $4601
; IRQ $0314 -> $ea31 (ROM)
; BRK $0316 -> $fe66 (ROM)
; NMI $0318 -> $fe47 (ROM)
; VIC bank 0 ($0000-$3fff), text, screen $0400, charset $1000 (ROM)
; interrupt sources: CIA1 timer A (IRQ), IRQs masked by the I flag
; BASIC program $0801-$2846
deflower copterduel.vsf
include c64.flo

; ---------------------------------------------------------------- ROM
; BASIC ROM routines the crack and the window routines call
$a533 banked basic_relink
$a659 banked basic_clr
$a7ae banked basic_newstt
$aefd banked basic_check_comma
$b79e banked basic_get_byte
$b7eb banked basic_get_addr_and_byte
; KERNAL parts of the reset that the crack repeats
$e3bf banked basic_init_ram
$e422 banked basic_print_startup
$e453 banked basic_init_vectors

; ---------------------------------------------------------------- zero page and system
; scratch byte of the collision checks
$02 virtual byte temp
; BASIC's line number / address (linnum): basic_get_addr_and_byte puts the address here
$14 virtual word basic_linnum
; end of the last LOAD; the crack sets it to the end of the BASIC program
$ae virtual word load_end
; screen pointer of the window routines
$fa virtual word window_screen_ptr
; the trainer prompt's screen position; the window routines' character save pointer
$fc virtual word ptr_fc
; the screen position of a rocket; the window routines' colour save pointer
$fe virtual word ptr_fe
; KERNAL memory bounds, set like the reset does
$0281 virtual word memory_bottom
$0283 virtual word memory_top

; ---------------------------------------------------------------- BASIC
; always 0 in front of a BASIC program
$0800 byte basic_start_zero
; The game's BASIC program: title, playfield, score screen, round loop.
; See copterduel_basic.txt.
$0801-$175e byte basic_program
; line 1011 LOAD"COPTER" (the crack makes it a REM)
$09a7 basic_load_token
; line 1107: the second and third red copter icons (trainer option 3)
$1700 basic_red_copter_2
$1702 basic_red_copter_3
$175e-$2ec0 virtual byte unused_175e

; ---------------------------------------------------------------- crack
; First 64 bytes of the BASIC program, copied to $0800 by crack_run_basic
; (the intro overwrote them)
$2ec0-$2f00 byte crack_basic_head
; Redoes the KERNAL's reset, runs the trainer menu, then RUNs the BASIC program
$2f00 code crack_run_basic
$2f84-$2fe0 virtual byte unused_2f84
; prompt shown after each question; the keys are its 2nd and 4th byte
$2fe0-$2fe5 ascii trainer_prompt
$2fe5-$2ff0 byte crack_unused_2fe5
; the answers, 1 = yes
$2ff0 byte trainer_unlimited_lives
$2ff1 byte trainer_no_points_red
$2ff2 byte trainer_one_life_red
$2ff3-$3000 byte crack_unused_2ff3
; trainer menu text, copied to the screen at $0518
$3000-$3100 screencode trainer_menu_text
; Shows the menu, asks three y/n questions and patches the game:
; unlimited lives for yellow, no points for red, one life for red
$3100 code trainer_menu
; first code of the game after the intro moved it here
$3181 code crack_start
$318e-$3200 virtual byte unused_318e
; Prints the prompt at ($fc), waits for Y or N, prints the key; returns it in A
$3200 code trainer_ask_yes_no
$3229-$4000 virtual byte unused_3229

; ---------------------------------------------------------------- screen (VIC bank 1)
; the game screen, drawn by the BASIC program
$4000-$43e8 virtual byte[1000] screen
; status panels, in screen codes: digits $30-$39, bars $23 (full) to $27 (empty),
; copter icon $5b, lost copter $3d
$4049 yellow_score
$40c0 yellow_energy_bar
$4138 yellow_rocket_bar
$41b1 yellow_copter_icons
$4251 red_score
$42c8 red_energy_bar
$4340 red_rocket_bar
$43b9 red_copter_icons
; bases of the four screen quarters in which bonuses appear
$40d8 bonus_area_2
$41d2 bonus_area_3
$42cc bonus_area_4
$43e8-$43f8 virtual byte unused_43e8
; sprite 0 yellow copter, 1 red copter, 2 yellow rocket, 3 red rocket
$43f8 virtual byte[8] sprite_pointers

; ---------------------------------------------------------------- sprites
; pointer $10-$17 copter, rotor up, facing left to right
$4400-$4600 byte copter_frames_a
; pointer $18-$1f copter, rotor down
$4600-$4800 byte copter_frames_b
; pointer $20
$4800-$4840 byte rocket_sprite
; pointer $21-$2a
$4840-$4ac0 byte explosion_frames
; pointer $2b-$32: title screen logo
$4ac0-$4cc0 byte title_sprites
$4cc0-$7800 virtual byte unused_4cc0

; ---------------------------------------------------------------- charset
; characters $00-$5f, the rest is unused
$7800-$7b00 byte charset
$7b00-$8000 virtual byte unused_7b00

; ---------------------------------------------------------------- engine
; sys32768: one round, returns when a player has lost all copters
$8000 code game_main
; Every other IRQ: toggles the copters between rotor frames, then the KERNAL IRQ
$803b code irq_rotor_animation
$8062 byte irq_odd
; the round's main loop, one pass per frame
$8063 code round_loop
; bit 0: yellow has no copters left, bit 1: red
$80b6 byte game_over_flags
; copies of the collision registers, read once per frame
$80b7 byte sprite_collisions
$80b8 byte background_collisions
; frames in a row that a copter touches the background
$80b9 byte yellow_wall_frames
$80ba byte red_wall_frames
; 0/1 alternately: bonuses are handled every other frame
$80bb byte odd_frame
; Every 30 frames both copters sink one pixel
$80bc code gravity
$80df byte gravity_delay
; Joystick in port 2: fly, turn, fire. While exploding: the explosion
$80e0 code yellow_control
; moves the yellow rocket 2 pixels
$81c7 code yellow_rocket_move
; Joystick in port 1, as yellow_control
$81de code red_control
$82c5 code red_rocket_move
; frames until the next turn step
$82dc byte yellow_turn_delay
$82dd byte red_turn_delay
; 0 none, 1 flying right, 2 flying left
$82de byte yellow_rocket
$82df byte red_rocket
; Rockets end at walls, copters crash on walls (2 frames) and on each other,
; rockets hit copters
$82e0 code collisions
; Starts or steps the yellow explosion; after it, a copter is lost, the
; copter is reset, and red gets 100 points
$8414 code yellow_hit
; trainer option 1 makes this a bit: no copter lost
$8499 yellow_lose_copter
$84cb code red_hit
$8582 byte yellow_exploding
$8583 byte red_exploding
$8584 byte yellow_explosion_delay
$8585 byte red_explosion_delay
$8586 byte yellow_explosion_step
$8587 byte red_explosion_step
; Every 250 frames: 1 point and a unit of energy less; out of energy is a crash
$8588 code yellow_tick
$85ad code red_tick
$85d2 byte yellow_tick_delay
$85d3 byte red_tick_delay
; Adds 1 to the yellow score (entry +3: adds 10, entry +6: adds 100),
; picking the digit with a bit instruction that skips the next ldx
$85d4 code yellow_score_add_1
$85d6 byte yellow_skip_ldx
$85d7 yellow_score_add_10
$85da code yellow_score_add_100
$85f0 code red_score_add_1
$85f2 byte red_skip_ldx
$85f3 red_score_add_10
$85f6 code red_score_add_100
; trainer option 2 makes this a bit: no points for red
$8608 red_score_inc
; Every 200 frames: replaces the four bonuses by new ones at random places
$860c code place_bonuses
$86b1 byte bonus_delay
$86b2 byte bonuses_placed
; screen offset of the bonus in each quarter
$86b3-$86b7 byte bonus_offsets
; $3a 10 points, $3b 3 rockets, $3c 5 energy
$86b7-$86bb byte bonus_chars
; The yellow rocket picks up the bonus it flies over
$86bb code yellow_rocket_bonus
$873c code red_rocket_bonus
$87bd byte yellow_rocket_column
$87be byte red_rocket_column
$87bf-$87d8 byte screen_row_lo
$87d8-$87f1 byte screen_row_hi
$87f1-$8800 byte unused_87f1

; ---------------------------------------------------------------- windows
; sysws,addr,width,height,colour: opens a framed window, saving what is under it
$8800 code window_open
; syswc: closes the last window opened
$8803 code window_close
$8806 code window_close_impl
; copies one character and its colour from the save buffers back to the screen
$888f code window_restore_char
$88c2 code window_open_impl
; saves the character and colour at ($fa) and draws the window's one
$89f3 code window_draw_char
; 6 windows of 8 bytes: screen address, width, height, char save, colour save
$8a2a-$8a5a byte window_stack
$8a5a byte window_count
$8a5b-$8a61 byte window_offsets
$8a61 byte window_height
$8a62 byte window_width
$8a63 byte window_row
$8a64 byte window_column
$8a65 byte window_colour
$8a66 word window_char_save
$8a68 word window_colour_save
$8a6a byte window_char
; colour RAM page minus screen page
$8a6b byte window_colour_offset

$8a6c-$8b00 virtual byte untouched_8a6c
$8b00-$8c03 virtual byte unused_8b00
$8c03-$a000 virtual byte untouched_8c03
; RAM under the BASIC ROM: what the windows cover
$a000-$b800 virtual byte window_char_buffer
$b800-$c000 virtual byte window_colour_buffer
$c000-$d000 virtual byte untouched_c000
$e000-$e531 virtual byte untouched_e000
$e551-$fd30 virtual byte untouched_e551
$fd50-$10000 virtual byte untouched_fd50
